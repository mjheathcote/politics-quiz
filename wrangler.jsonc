{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name as it will appear in the Cloudflare dashboard. If you ever
  // connect this repo via Cloudflare's own Git integration (Workers Builds)
  // instead of the GitHub Actions deploy below, this MUST match the Worker
  // name set up in the dashboard, or the build fails.
  "name": "politics-quiz",
  // Bump deliberately when you want to opt into newer Workers runtime
  // behavior — see https://developers.cloudflare.com/workers/configuration/compatibility-dates/.
  // Not auto-generated at build time on purpose, so behavior doesn't drift
  // silently between deploys.
  "compatibility_date": "2026-08-19",
  // Assets-only Worker: no "main" entry point, no Worker script at all. The
  // whole site is static (Astro `output: "static"`), so there is nothing for
  // a Worker script to do — Cloudflare serves dist/ directly from the edge.
  // See src/pages/answer-key.json.ts's comment for why that's still a plain
  // static file even though it's generated by an Astro "endpoint" — it's
  // prerendered to a real file in dist/ at build time, same as index.html.
  "assets": {
    "directory": "./dist"
  }
}
