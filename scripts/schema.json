{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PartyPolicyFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["party", "partyId", "asOf", "policies"],
  "properties": {
    "party": { "type": "string", "minLength": 1 },
    "partyId": {
      "type": "string",
      "enum": ["labour", "conservative", "reform", "libdem", "green"]
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "policies": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "statement", "sourceUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "statement": { "type": "string", "minLength": 20, "maxLength": 400 },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
